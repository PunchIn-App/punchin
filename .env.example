# PunchIn Sync Configuration
# Copy this to .env.local and fill in your OAuth app credentials.
# These VITE_* values are PUBLIC client IDs (they ship in the bundle) — never put
# client secrets here. Each provider's secret is a Cloudflare *Worker secret*
# (GOOGLE_CLIENT_SECRET / ONEDRIVE_CLIENT_SECRET), and the worker also needs each
# client ID as a runtime var (GOOGLE_CLIENT_ID / ONEDRIVE_CLIENT_ID) — see
# wrangler.jsonc. All three providers run the Authorization Code flow through the
# worker, so every redirect URI must be the worker callback below, byte-identical.

# GitHub: create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: https://your-app.workers.dev/oauth/github/callback
VITE_GITHUB_CLIENT_ID=

# Google: create OAuth credentials at https://console.cloud.google.com
# App type: Web application
# Enable: Google Drive API, scope: drive.appdata
# Authorized redirect URI: https://your-app.workers.dev/oauth/google/callback
VITE_GOOGLE_CLIENT_ID=

# Microsoft: register an app at https://portal.azure.com
# Supported account types: Personal Microsoft accounts
# Redirect URI — platform "Web" (NOT "Single-page application", which caps the
# refresh token at 24h): https://your-app.workers.dev/oauth/onedrive/callback
# API permissions: Files.ReadWrite.AppFolder, User.Read, offline_access
VITE_ONEDRIVE_CLIENT_ID=

# Dropbox: create a "Scoped access" app with "App folder" access at
# https://www.dropbox.com/developers/apps
# Redirect URI: https://your-app.workers.dev/oauth/dropbox/callback
# Scopes (Permissions tab): files.content.write, files.content.read, files.metadata.read
# This is the app's "App key"; the "App secret" is the worker's DROPBOX_APP_SECRET.
VITE_DROPBOX_APP_KEY=

# Your deployed app URL — must equal the worker's APP_URL var and the registered
# redirect URIs' origin (used to build every provider's redirect_uri).
VITE_APP_URL=https://your-app.workers.dev
